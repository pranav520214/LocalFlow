  },
  "devDependencies": {
    "@electron/packager": "^19.0.0",
    "electron": "^40.0.0",
    "playwright": "^1.63.0"
  },
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.2.1"
  }
}
