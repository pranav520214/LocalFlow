{
  "name": "localflow",
  "version": "0.1.0",
  "description": "Private desktop dictation and prompt engineering with NeMo-Speech.cpp and llama.cpp",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
